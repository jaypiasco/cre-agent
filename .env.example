# LLM Provider: "openai", "anthropic", or "mock" (offline demo mode)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-latest
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-latest

# Langfuse Observability (Optional - gracefully falls back to local logging if unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Streamlit Frontend -> FastAPI Backend URL
API_BASE_URL=http://127.0.0.1:8000
