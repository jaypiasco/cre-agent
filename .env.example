# LLM Provider: "gemini", "openai", "anthropic", or "mock" (offline demo mode)
LLM_PROVIDER=gemini

# Google Gemini Configuration (Free tier available via Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
# Optional comma-separated key pool for automatic quota rotation:
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=gpt-6.2-sol

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5

# Langfuse Observability (Optional - gracefully falls back to local logging if unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=dev

# Frontend -> FastAPI Backend URL
API_BASE_URL=http://127.0.0.1:8000
